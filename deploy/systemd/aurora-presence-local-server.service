[Unit]
Description=Aurora local multi-instance presence server
Wants=network-online.target aurora-relay.service
After=network-online.target aurora-relay.service

[Service]
Type=simple
User=carl
Group=carl
Environment=AURORA_LOCAL_HOOK_ENABLED=1
ExecStart=/usr/local/bin/aurora-presence-local-server -host-id %H -socket /run/aurora/presence-hook.sock -snapshot-file /run/aurora/snapshot.json -relay http://127.0.0.1:8080
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=10s

RuntimeDirectory=aurora
RuntimeDirectoryMode=0700
UMask=0077

StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/carl/.codex
BindReadOnlyPaths=-/home/carl/.codex-business
InaccessiblePaths=/home/carl/.codex/auth.json
InaccessiblePaths=-/home/carl/.codex-business/auth.json
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
